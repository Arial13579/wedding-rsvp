rules_version = '2';

// Firebase project wedding-rsvp-e2e0f is shared by TWO sites: the wedding RSVP and the
// Snap Box quotes site. Publishing replaces ALL rules, so both must stay in this one file.
//
// Wedding RSVP — security rules.
// Paste into: Firebase Console ▸ Firestore Database ▸ Rules ▸ Publish.
// Owner: arielkahalani1@gmail.com (full access).
// Collaborators: people who joined through an active share link; they manage only the guests they added.
// Guests: anyone holding a guest's private token can read that one invitation and answer it.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isOwner() {
      return signedIn()
        && request.auth.token.email == 'arielkahalani1@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function collabPath() {
      return /databases/$(database)/documents/collaborators/$(request.auth.uid);
    }

    function isCollab() {
      return signedIn() && exists(collabPath()) && get(collabPath()).data.active == true;
    }

    function isAdmin() { return isOwner() || isCollab(); }

    function validCount(n) { return n is int && n >= 0 && n <= 30; }

    // Public event details + invitation image. Only the owner edits them.
    match /meta/{docId} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isOwner();
    }

    match /guests/{guestId} {
      allow get: if true;
      allow list: if isOwner() || (isCollab() && resource.data.addedByUid == request.auth.uid);

      allow create: if isAdmin()
        && request.resource.data.addedByUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120;

      allow delete: if isOwner() || (isCollab() && resource.data.addedByUid == request.auth.uid);

      allow update: if isOwner()
        || (isCollab()
            && resource.data.addedByUid == request.auth.uid
            && request.resource.data.addedByUid == request.auth.uid)
        // The guest answering from the invitation page
        || (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'adults', 'children', 'total', 'updatedAt', 'remindOn', 'diet', 'message'])
            && request.resource.data.status in ['yes', 'maybe', 'no']
            && request.resource.data.get('diet', '') in ['', 'veg', 'vegan', 'gf', 'other']
            && request.resource.data.get('message', '') is string
            && request.resource.data.get('message', '').size() <= 500
            && validCount(request.resource.data.adults)
            && validCount(request.resource.data.children)
            && request.resource.data.total == request.resource.data.adults + request.resource.data.children
            && request.resource.data.updatedAt == request.time);
    }

    match /shareLinks/{token} {
      allow get: if signedIn();
      allow list, create, update, delete: if isOwner();
    }

    match /collaborators/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isOwner());
      allow list: if isOwner();
      // Joining with an active share link
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.active == true
        && exists(/databases/$(database)/documents/shareLinks/$(request.resource.data.via))
        && get(/databases/$(database)/documents/shareLinks/$(request.resource.data.via)).data.active == true;
      allow update, delete: if isOwner();
    }

    // ═══════════════════════════════════════════════════════════════════
    //  Snap Box quotes site (SnapBoxEvent_quotation) — shares this Firebase
    //  project. Copied unchanged from that repo's _tests/firestore-full.rules.
    // ═══════════════════════════════════════════════════════════════════
    function isSnapAdmin() {
      return request.auth != null && request.auth.token.email == 'snapboxevent.official@gmail.com';
    }

    match /snapbox_quotes/{id} {
      allow get: if true;
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.clientName is string
                    && request.resource.data.price is number;
      allow list, delete: if isSnapAdmin();
      allow update: if isSnapAdmin()
        || (
            resource.data.status == 'pending' &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'signedAt', 'ip', 'userAgent'])
           )
        || (
            resource.data.status == 'signed' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pdfData']) &&
            request.resource.data.pdfData.size() < 1000000
           );
    }

    match /snapbox_expenses/{id} {
      allow read, delete: if isSnapAdmin();
      allow create, update: if isSnapAdmin()
        && request.resource.data.keys().hasOnly(['date', 'amount', 'label', 'category', 'createdAt'])
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.label is string && request.resource.data.label.size() <= 120;
    }

    match /snapbox_incomes/{id} {
      allow read, delete: if isSnapAdmin();
      allow create, update: if isSnapAdmin()
        && request.resource.data.keys().hasOnly(['date', 'amount', 'label', 'category', 'createdAt'])
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.label is string && request.resource.data.label.size() <= 120;
    }

    match /snapbox_events/{id} {
      allow read, delete: if isSnapAdmin();
      allow create, update: if isSnapAdmin() && request.resource.data.size() <= 40;
    }
  }
}
